<script>
  // Simple interactive filter logic for collaborator search and table row filtering
  const searchInput = document.getElementById('search-input');
  const rosterBody = document.getElementById('roster-tbody');
  
  if (searchInput && rosterBody) {
    searchInput.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      const rows = rosterBody.querySelectorAll('tr');
      
      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        if (text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });
  }

  // Density Toggle Micro-interaction
  const btnAmplo = document.getElementById('view-amplo');
  const btnCompacto = document.getElementById('view-compacto');
  const tableWrap = document.getElementById('schedule-table-wrap');

  if (btnAmplo && btnCompacto && tableWrap) {
    btnCompacto.addEventListener('click', () => {
      btnCompacto.classList.add('bg-surface-container-high', 'text-primary');
      btnCompacto.classList.remove('text-on-surface-variant');
      btnAmplo.classList.remove('bg-surface-container-high', 'text-primary');
      btnAmplo.classList.add('text-on-surface-variant');

      const cells = tableWrap.querySelectorAll('td, th');
      cells.forEach(c => {
        c.classList.add('py-1');
        c.classList.remove('py-space-md', 'py-space-sm');
      });
    });

    btnAmplo.addEventListener('click', () => {
      btnAmplo.classList.add('bg-surface-container-high', 'text-primary');
      btnAmplo.classList.remove('text-on-surface-variant');
      btnCompacto.classList.remove('bg-surface-container-high', 'text-primary');
      btnCompacto.classList.add('text-on-surface-variant');

      const cells = tableWrap.querySelectorAll('td, th');
      cells.forEach(c => {
        c.classList.remove('py-1');
        c.classList.add('py-space-md');
      });
    });
  }
